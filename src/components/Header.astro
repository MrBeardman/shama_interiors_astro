---
import Social from './ui/Social.astro';
import { dict, url, LANGS, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';

interface Props {
  lang: Lang;
  /** English-style path of this page, e.g. /about-us/ */
  path: string;
}
const { lang, path } = Astro.props;
const t = dict(chrome, lang);
const other = LANGS.find((l) => l.code !== lang)!;
const isCurrent = (href: string) => path === href || (href === '/inspirations/' && path.startsWith('/inspiration/'));
---

<header class="hd" data-header>
  <div class="hd-in">
    <a class="logo" href={url(lang, '/')} aria-label={t.brand}>
      <img src="/media/logo.webp" width="325" height="75" alt={t.brand} />
    </a>
    <nav class="nav" aria-label={t.menu}>
      {t.nav.map((n) => (
        <a href={url(lang, n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
    <div class="hd-side">
      <Social />
      <a class="lang" href={url(other.code, path)} hreflang={other.code} lang={other.code} aria-label={t.switch}>
        {other.short}
      </a>
    </div>
    <button
      class="burger"
      type="button"
      data-burger
      aria-expanded="false"
      aria-controls="drawer"
      aria-label={t.menu}
      data-open={t.menu}
      data-close={t.close}
    >
      <i></i>
      <i></i>
    </button>
  </div>
</header>
<div class="drawer" id="drawer" data-drawer inert>
  <ul>
    {t.nav.map((n, i) => (
      <li>
        <a href={url(lang, n.href)} style={`--i:${i}`}>
          {n.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="drawer-foot">
    <Social />
    <a class="lang" href={url(other.code, path)} hreflang={other.code} lang={other.code} aria-label={t.switch}>
      {other.short}
    </a>
  </div>
</div>
