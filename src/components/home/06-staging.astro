---
import Frame from '../ui/Frame.astro';
import Lines from '../ui/Lines.astro';
import Arrow from '../ui/Arrow.astro';
import { dict, url, type Lang } from '../../i18n';
import chrome from '../../i18n/chrome.json';
import pages from '../../i18n/pages.json';

const { lang } = Astro.props as { lang: Lang };
const c = dict(chrome, lang);
const t = dict(pages, lang);
---

<section class="hg sec">
  <div class="wrap">
    <div class="hg-head">
      <Lines text={t.staging_h1} class="h2" />
      <a class="more" href={url(lang, '/home-staging/')} data-rv="up">
        <span>{c.nav[3].label}</span>
        <Arrow />
      </a>
    </div>
    <div class="hg-stack">
      {t.staging.map((s, i) => (
        <article class="hg-card" data-stack style={`--i:${i}`}>
          <div class="hg-inner">
            <Frame name={s.img} alt={s.alt} sizes="(max-width: 999px) 150vw, 70vw" class="hg-photo" from="left" />
            <div class="hg-copy">
              <span class="num" data-rv="up">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Lines text={s.t} tag="h3" class="h2 hg-title" />
              <p data-rv="up" style="--i:3">
                {s.p}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .hg {
    background: var(--deep);
  }
  .hg .h2 {
    color: #fff;
  }
  .hg .more {
    color: #fff;
  }
  .hg-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .hg-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 40px);
  }
  .hg-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--paper);
    transform-origin: 50% 0;
    transition: transform 420ms var(--ease-out);
  }
  .hg-photo {
    min-height: 100%;
  }
  .hg-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: clamp(28px, 4vw, 60px);
  }
  .hg-copy .hg-title {
    color: var(--ink);
    font-size: clamp(24px, 2.9vw, 42px);
  }
  @media (min-width: 1000px) and (min-height: 700px) {
    .hg-card {
      position: sticky;
      top: calc(24px + var(--i) * 18px);
    }
    .hg-inner {
      min-height: min(74vh, 620px);
    }
  }
  @media (max-width: 999px) {
    .hg-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .hg-photo {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }
</style>
