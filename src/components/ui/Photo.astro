---
import media from '../../data/media.json';

interface Props {
  name: string;
  alt: string;
  /** Must describe the cover crop, not the frame: a tall crop of a landscape photo needs a wider file than the frame. */
  sizes: string;
  eager?: boolean;
  class?: string;
  [key: `data-${string}`]: unknown;
}
const { name, alt, sizes, eager = false, class: cls, ...rest } = Astro.props;
const m = (media as Record<string, { w: number; h: number; widths: number[] }>)[name];
if (!m) throw new Error(`Unknown photo: ${name}`);
const largest = m.widths[m.widths.length - 1];
const fallback = m.widths.includes(1280) ? 1280 : largest;
---

<img
  class={cls}
  src={`/media/${name}-${fallback}.webp`}
  srcset={m.widths.map((w) => `/media/${name}-${w}.webp ${w}w`).join(', ')}
  sizes={sizes}
  width={m.w}
  height={m.h}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  {...rest}
/>
