---
import '../styles/fonts.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, langInfo, url, dict, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import pages from '../i18n/pages.json';

interface Props {
  lang: Lang;
  title: string;
  /** English-style path, e.g. /about-us/ */
  path: string;
  description?: string;
}
const { lang, title, path } = Astro.props;
const description = Astro.props.description ?? dict(pages, lang).home_desc;
const site = Astro.site!;
const info = langInfo(lang);
const t = dict(chrome, lang);
const canonical = new URL(url(lang, path), site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Schama Interiors',
  url: 'https://schamainteriors.es/',
  logo: 'https://schamainteriors.es/favicon-512.png',
  email: 'info@schamainteriors.es',
  telephone: '+447401560665',
  sameAs: [
    'https://www.facebook.com/profile.php?id=61555404392143',
    'https://www.instagram.com/jana_schama_interiors/',
  ],
};
---

<!doctype html>
<html lang={info.locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      // If the script never arrives, nothing may stay hidden.
      setTimeout(function () {
        if (!window.__si) document.documentElement.classList.remove('js');
      }, 4000);
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l.code} href={new URL(url(l.code, path), site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />
    <meta property="og:locale" content={info.og} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Schama Interiors" />
    <meta property="og:image" content={new URL('/media/og.jpg', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Demo on a preview URL: remove at launch (docs/STATUS.md). -->
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />
    <link rel="preload" href="/fonts/josefin-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">
      {t.skip}
    </a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <Header lang={lang} path={path} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
